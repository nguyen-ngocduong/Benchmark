
    "tools": [
        {
            "type": "function",
            "function": {
                "name": "get_gold_price",
                "description": "Retrieve current market gold prices or historical gold price trends in Vietnam. Supports querying by specific date range and provider/brand (e.g. SJC, PNJ, DOJI, Mi Hong). Use action='current' for real-time rates, or action='history' with from_date and to_date for historical records.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "action": {
                            "type": "string",
                            "enum": [
                                "current",
                                "history"
                            ],
                            "description": "The query mode: 'current' retrieves the latest real-time gold prices; 'history' retrieves historical price data over a date range."
                        },
                        "from_date": {
                            "type": "string",
                            "format": "date",
                            "description": "Start date in 'YYYY-MM-DD' format (e.g. '2026-08-15'). Required when action is 'history'."
                        },
                        "to_date": {
                            "type": "string",
                            "format": "date",
                            "description": "End date in 'YYYY-MM-DD' format (e.g. '2026-08-20'). Required when action is 'history'."
                        },
                        "source": {
                            "type": "string",
                            "enum": [
                                "SJC",
                                "BTMC",
                                "DOJI",
                                "BTMH",
                                "PNJ"
                            ],
                            "default": "SJC",
                            "description": "Filter by source: SJC, BTMC, DOJI, BTMH, PNJ. "
                        }
                    },
                    "required": [
                        "action"
                    ],
                    "additionalProperties": false
                }
            }
        },
        {
            "type": "function",
            "function": {
                "name": "get_weather",
                "description": "Look up weather forecasts, current conditions, temperature ranges, humidity, and precipitation for locations in Vietnam. Only supports locations in Vietnam. For locations outside Vietnam or unavailable locations, tell the user that weather lookup is only supported in Vietnam; do not use search_web or any other fallback.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "keyword": {
                            "type": "string",
                            "description": "Location or city name in Vietnam to search weather for (e.g. 'Hà Nội', 'TP Hồ Chí Minh', 'Đà Nẵng', 'Hải Phòng')."
                        },
                        "date": {
                            "type": "string",
                            "description": "Omit or leave empty for current weather. Do not use 'today'. For forecasts, provide the target/start date in YYYY-MM-DD format."
                        },
                        "date_end": {
                            "type": "string",
                            "description": "Ignored when date is omitted or empty, regardless of whether date_end is supplied. Optional forecast end date in YYYY-MM-DD format. When omitted, the forecast is for date only. Provide both date and date_end to request a date range."
                        }
                    },
                    "required": [
                        "keyword"
                    ],
                    "additionalProperties": false
                }
            }
        },
        {
            "type": "function",
            "function": {
                "name": "search_web",
                "description": "Use this tool only by its exact registered name: search_web. Never call search_query, search_search_web, web_search, or any other alias. Never use this tool for weather, weather forecasts, or current weather conditions; use get_weather only and do not provide a web-search fallback when it is unavailable. Perform live web searches for current events, news, sports, general facts, and real-time data, including public facts and market data not covered by dedicated gold or weather lookups. Use category='news' for news and current affairs, category='sports' for schedules, results, rankings, transfers, injuries, and other sports information, and category='encyclopedia' for other factual topics. When no time is specified for news, prefer the latest available information. For sports, prefer the nearest relevant schedule or result and verify volatile claims such as transfers, injuries, scores, and rankings before stating them as facts. Do not invent future news or state unconfirmed sports claims as facts. For Vietnamese topics, preserve or construct the query in natural, fully-accented Vietnamese (tiếng Việt có dấu đầy đủ); never transliterate it to unaccented text. Supports normal and deep_research modes; deep_research synthesizes information from multiple authoritative sources.",
                "parameters": {
                    "additionalProperties": false,
                    "properties": {
                        "query": {
                            "description": "Natural language search query. For Vietnamese topics, preserve or write natural, fully-accented Vietnamese (tiếng Việt có dấu đầy đủ); never transliterate it to unaccented text.",
                            "maxLength": 4000,
                            "minLength": 1,
                            "type": "string"
                        },
                        "mode": {
                            "default": "normal",
                            "enum": [
                                "normal",
                                "deep_research"
                            ],
                            "type": "string"
                        },
                        "category": {
                            "enum": [
                                "news",
                                "sports",
                                "encyclopedia"
                            ],
                            "type": "string"
                        }
                    },
                    "required": [
                        "query",
                        "category"
                    ],
                    "type": "object"
                }
            }
        },
        {
            "type": "function",
            "function": {
                "name": "query_knowledge_base",
                "description": "Search and retrieve authoritative documents from the internal knowledge base regarding VinDynamics, Vingroup ecosystem, butler robot Dyno specifications, features, hardware capabilities, smart home integration, and organizational information.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "keyword": {
                            "type": "string",
                            "description": "Question, keywords, or search phrase to query against internal knowledge chunks."
                        },
                        "unknown_answer": {
                            "type": "string",
                            "default": "",
                            "description": "Optional fallback text to return if no relevant knowledge base document matches."
                        },
                        "limit_chunk": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 20,
                            "default": 10,
                            "description": "Maximum number of top-matching document chunks to return (1-20, default 10)."
                        },
                        "categories": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "default": [],
                            "description": "Optional list of document category tags to restrict the search scope."
                        }
                    },
                    "required": [
                        "keyword"
                    ],
                    "additionalProperties": false
                }
            }
        },
        {
            "type": "function",
            "function": {
                "name": "execute_robot_command",
                "description": "Execute a mock household robot command for movement, lights, area inspection, or calling an allowed family contact. Use structured identifiers only; never send a raw command string.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "action": {
                            "type": "string",
                            "enum": [
                                "move",
                                "set_light",
                                "inspect",
                                "call"
                            ],
                            "description": "The household robot operation to perform. Use inspect for both one-time area checks and patrol requests."
                        },
                        "robot_id": {
                            "type": "string",
                            "default": "robot-demo-01",
                            "description": "Optional robot identifier; use robot-demo-01 for this mock demo."
                        },
                        "location_id": {
                            "type": "string",
                            "enum": [
                                "floor_1",
                                "floor_2",
                                "floor_3",
                                "living_room",
                                "bedroom",
                                "kitchen",
                                "garden"
                            ],
                            "description": "Household location for move, set_light, or inspect. Required for those actions and omitted for call."
                        },
                        "light_state": {
                            "type": "string",
                            "enum": [
                                "on",
                                "off"
                            ],
                            "description": "Required only for action=set_light."
                        },
                        "contact_id": {
                            "type": "string",
                            "enum": [
                                "family_mom",
                                "family_dad",
                                "family_older_brother",
                                "family_older_sister",
                                "family_younger_brother",
                                "family_younger_sister"
                            ],
                            "description": "Allowed family contact for action=call; do not use phone numbers."
                        }
                    },
                    "required": [
                        "action"
                    ],
                    "additionalProperties": false
                }
            }
        }
    ]
